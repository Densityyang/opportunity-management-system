{
  "name": "opportunity-management-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @oms/api --filter @oms/web dev",
    "build": "pnpm --filter @oms/contracts build && pnpm --filter @oms/api build && pnpm --filter @oms/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @oms/contracts build && pnpm --filter @oms/contracts typecheck && pnpm --filter @oms/api typecheck && pnpm --filter @oms/web typecheck",
    "test": "pnpm --filter @oms/api test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @oms/api prisma:generate",
    "db:migrate": "pnpm --filter @oms/api prisma:migrate",
    "db:seed": "pnpm --filter @oms/api prisma:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.66.0"
  }
}
