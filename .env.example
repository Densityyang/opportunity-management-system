# Copy to .env for local Docker Compose use. Never commit real values.
NODE_ENV=development
TZ=Asia/Shanghai
POSTGRES_DB=opportunity_management
POSTGRES_USER=oms
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://oms:replace-with-a-long-random-password@postgres:5432/opportunity_management

# Generate each 32-byte key independently: openssl rand -base64 32
PII_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
AUDIO_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
BLIND_INDEX_KEY_BASE64=replace-with-32-byte-base64-key
SESSION_PEPPER=replace-with-a-long-random-string

COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
AUDIO_STORAGE_PATH=/data/audio
DATA_RETENTION_YEARS=3
AUDIO_RETENTION_DAYS=90

# One-time bootstrap administrator; seed fails if these are missing.
BOOTSTRAP_ADMIN_PHONE=13800000000
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-initial-password
